# ─── Core ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3300
# Postgres connection string (Neon/Supabase/RDS). Leave empty for local PGlite.
DATABASE_URL=
# Admin login (Admin → /admin). Required in production.
ADMIN_PASSWORD=
# 32+ random chars: `openssl rand -base64 32`
AUTH_SECRET=
# Bearer token for /api/cron/* (Vercel Cron sends it automatically as CRON_SECRET)
CRON_SECRET=

# ─── Stripe (payments) ───────────────────────────────────────────────────
# Without these, a built-in test checkout page is used (local dev only).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Cal.com (shared calendar: Google ⇄ Airbnb) ─────────────────────────
# Without these, the built-in availability engine is used on its own.
CALCOM_API_KEY=
CALCOM_WEBHOOK_SECRET=
# CALCOM_API_URL=https://api.cal.com/v2

# ─── Email (Resend) ──────────────────────────────────────────────────────
# Without RESEND_API_KEY, emails are only recorded in Admin → Emails.
RESEND_API_KEY=
EMAIL_FROM="Raw Planet Experiences <bookings@rawplanetexperiences.com>"
CONTACT_EMAIL=hello@rawplanetexperiences.com
HOST_NOTIFICATION_EMAIL=

# ─── Community ───────────────────────────────────────────────────────────
MEETUP_GROUP_URL=

# Demo deploys only: show the fake "pay" button in production when Stripe is not configured. Never set on the live site.
ALLOW_TEST_CHECKOUT=

# Cloudflare Turnstile (bot check on public forms). Leave empty to turn it off.
# Testing: site key 1x00000000000000000000AA + secret 1x0000000000000000000000000000000AA always pass.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
